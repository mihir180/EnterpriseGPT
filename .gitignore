# --- Secrets, never commit these ---
.env
.env.local
.env.production
backend/.env
frontend/.env.local
*.pem

# --- Python ---
venv/
__pycache__/
*.pyc
backend/venv/

# --- Node / Next.js ---
node_modules/
.next/
frontend/node_modules/
frontend/.next/

# --- Uploaded files / runtime data (don't commit user uploads) ---
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.log

# --- Docker ---
*.pid
