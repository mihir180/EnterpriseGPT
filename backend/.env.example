# --- Database ---
DATABASE_URL=postgresql+asyncpg://enterprisegpt:enterprisegpt@localhost:5432/enterprisegpt
DATABASE_URL_SYNC=postgresql://enterprisegpt:enterprisegpt@localhost:5432/enterprisegpt

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprisegpt_chunks
QDRANT_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- File storage ---
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- App ---
ENV=development
CORS_ORIGINS=http://localhost:3000
